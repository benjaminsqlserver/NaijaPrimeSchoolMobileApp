@* Page title row with an optional back link and action buttons. *@
<div class="nps-page-header">
    <div class="nps-page-header-main">
        @if (!string.IsNullOrEmpty(BackHref))
        {
            <a class="nps-back" href="@BackHref" aria-label="Back"><span class="rzi">arrow_back</span></a>
        }
        <div>
            <h1>@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="nps-page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
