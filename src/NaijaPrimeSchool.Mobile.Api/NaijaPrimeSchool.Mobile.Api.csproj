<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Backend-for-mobile. Devices never hold a SQL Server connection string:
    they call this API over HTTPS with a JWT, and the API runs the web app's
    own Application services (Infrastructure layer, EF Core, SQL Server)
    against the same NaijaPrimeSchool database. Every business rule, soft
    delete, lookup-table check and audit-trail write therefore happens in
    exactly the same code path as on the web.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>naijaprimeschool-mobile-api-6b0f1e0c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(NaijaPrimeSchoolWebSrc)NaijaPrimeSchool.Infrastructure\NaijaPrimeSchool.Infrastructure.csproj" />
    <ProjectReference Include="..\NaijaPrimeSchool.Mobile.Contracts\NaijaPrimeSchool.Mobile.Contracts.csproj" />
  </ItemGroup>

</Project>
