<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- WebAssembly half of the Blazor Web (Auto) host: the shared UI runs in
       the browser and calls NaijaPrimeSchool.Mobile.Api directly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NaijaPrimeSchool.Mobile.Shared\NaijaPrimeSchool.Mobile.Shared.csproj" />
  </ItemGroup>

</Project>
