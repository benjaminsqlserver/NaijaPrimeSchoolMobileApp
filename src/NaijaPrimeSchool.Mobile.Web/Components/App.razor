<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#064e2b" />
    <title>Naija Prime School</title>
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-base.css" />
    <link rel="stylesheet" href="@Assets["_content/NaijaPrimeSchool.Mobile.Shared/app.css"]" />
    <link rel="stylesheet" href="@Assets["NaijaPrimeSchool.Mobile.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderMode" />
</head>

<body>
    @* Interactive Auto: starts on the server, then switches to WebAssembly
       once downloaded. Prerendering is off because the session token lives
       in the browser's storage, which only exists once interactive. *@
    <Routes @rendermode="RenderMode" />
    <ReconnectModal />
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode RenderMode = new InteractiveAutoRenderMode(prerender: false);
}
